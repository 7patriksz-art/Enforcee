# Anthropic — powers the judged layer only. Enforza runs inference; users do not bring keys.
ANTHROPIC_API_KEY=
ENFORZA_JUDGE_MODEL=claude-sonnet-4-5
ENFORZA_JUDGE_SAMPLES=3

# Optional: override per-1M-token prices without a deploy, e.g.
# ENFORZA_PRICE_OVERRIDES={"claude-sonnet-4-5":{"input":3,"output":15}}
ENFORZA_PRICE_OVERRIDES=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set NEXT_PUBLIC_SITE_URL in production so magic-link redirects resolve correctly.
NEXT_PUBLIC_SITE_URL=

# Stripe — optional. Without these the pricing page renders and checkout says it is not live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
