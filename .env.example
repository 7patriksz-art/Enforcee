# Anthropic — powers the judged layer only, and only for subscribers.
ANTHROPIC_API_KEY=
ENFORCEE_JUDGE_MODEL=claude-haiku-4-5
ENFORCEE_JUDGE_SAMPLES=3

# Optional: override per-1M-token prices without a deploy, e.g.
# ENFORCEE_PRICE_OVERRIDES={"claude-haiku-4-5":{"input":1,"output":5}}
ENFORCEE_PRICE_OVERRIDES=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set NEXT_PUBLIC_SITE_URL in production so magic-link redirects resolve correctly.
NEXT_PUBLIC_SITE_URL=

# Stripe — optional. Without these the pricing page renders and checkout says it is not live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BUILDER_MONTHLY=
STRIPE_BUILDER_YEARLY=
STRIPE_FOUNDER_MONTHLY=
STRIPE_FOUNDER_YEARLY=

# Comma-separated emails allowed into /admin. Empty means the workspace is closed to everyone.
ADMIN_EMAILS=

# Judged-path spend protection. Deterministic audits are never metered.
ENFORCEE_JUDGE_ANON_DAILY=5
ENFORCEE_JUDGE_USER_DAILY=50
ENFORCEE_JUDGE_GLOBAL_DAILY=2000
ENFORCEE_QUOTA_SALT=

# Offline licensing. The private half of the Ed25519 pair whose public half is committed
# in src/lib/licence-key.ts. Required to issue licences; never sent to a browser, never
# logged. Paste the PEM with real newlines, or with \n escapes — both are accepted.
ENFORCEE_LICENCE_PRIVATE_KEY=

# Billing interlock. Off by default: Vercel Hobby forbids commercial use, so
# taking a payment before the project is on Pro is a terms breach, not a soft limit.
# Set to 1 only once the Vercel project is actually on Pro.
ENFORCEE_BILLING_ENABLED=
