{
  "name": "enforcee",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:cli": "esbuild cli/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=cli/dist/enforcee.mjs --banner:js=\"#!/usr/bin/env node\"",
    "test:cli": "npm run build:cli && node cli/dist/enforcee.mjs --version",
    "pack:cli": "node scripts/pack-cli.mjs --check",
    "publish:cli": "node scripts/pack-cli.mjs --check && npm publish ./npm-dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "bin": {
    "enforcee": "./cli/dist/enforcee.mjs"
  },
  "files": [
    "cli/dist",
    "guard",
    "README.md"
  ]
}
